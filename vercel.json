{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__vercel_path=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__vercel_path=/api"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__vercel_path=/health"
    },
    {
      "source": "/backend/api/(.*)",
      "destination": "/api/index.py?__vercel_path=/backend/api/$1"
    }
  ]
}