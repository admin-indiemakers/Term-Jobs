{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/requisitions/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/requisitions",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/company-profiles/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/company-profiles",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/candidates/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/candidates",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/templates/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/templates",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/health",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}