# --- Core ---
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=TERMJOB
MONGO_DB_NAME=termjobs

# JWT signing secret (change for real deployments)
JWT_SECRET_KEY=your_jwt_secret_key_here

# Gmail notifications (Credential emails + Candidate Screening Agent)
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# --- Groq (cloud LLM) ---
# Get an API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# 3-tier routing: {"small": "...", "mid": "...", "large": "..."}
MODEL_TIERS={"small": "openai/gpt-oss-20b", "mid": "openai/gpt-oss-120b", "large": "openai/gpt-oss-120b"}

# --- Agent guardrails ---
MAX_INTAKE_TURNS=8
MAX_TOOL_CALLS=5
CONFIDENCE_THRESHOLD=0.7

# --- Calendar OAuth ---
CALENDAR_REDIRECT_BASE=http://localhost:8000
CALENDAR_FRONTEND_URL=http://localhost:5173/dashboard/admin

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# VOICE
SARVAM_AI=your_sarvam_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_API_KEY=your_sarvam_api_key_here
SARVAM_TTS_API_KEY=your_sarvam_api_key_here

# --- Telegram Bot Alerts (Candidates) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=Termjobs_alertbot
FRONTEND_BASE_URL=http://localhost:5173
INTERVIEW_PUBLIC_DOMAIN=https://termjobs.in

# --- Hiring Manager AI Telegram Bot ---
HM_TELEGRAM_BOT_TOKEN=your_hm_telegram_bot_token_here
HM_TELEGRAM_BOT_USERNAME=HirMngerbot

WAITLIST_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/.../exec
