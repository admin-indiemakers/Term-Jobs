{
  "routes": [
    {
      "src": "/(?:assets/.*|index\\.html|)$",
      "headers": { "Cache-Control": "no-cache" },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/proxy?__path=$1"
    },
    { "handle": "filesystem" },
    {
      "src": "/assets(?:/.*)?",
      "status": 404,
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "src": "/.*",
      "dest": "/index.html",
      "headers": { "Cache-Control": "no-cache" }
    }
  ]
}
